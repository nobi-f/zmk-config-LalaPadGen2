#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <1 0>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        BS {
            bindings = <&kp BSPC>;
            key-positions = <8 9>;
        };

        ENTR {
            bindings = <&kp ENTER>;
            key-positions = <18 17>;
        };

        Del {
            bindings = <&kp DELETE>;
            key-positions = <28 27>;
        };

        Win_Layer {
            bindings = <&to 4>;
            key-positions = <14 15>;
        };

        Def_Layer {
            bindings = <&to 0>;
            key-positions = <24 25>;
        };

        BS2 {
            bindings = <&kp BSPC>;
            key-positions = <8 7>;
        };

        ESC2 {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q      &kp W             &kp E         &kp R        &kp T                                                                    &kp Y                    &kp U           &kp I                         &kp O                   &kp P
&kp A      &kp S             &kp D         &kp F        &kp G                                                                    &kp H                    &kp J           &kp K                         &kp L                   &mt2 EQUAL MINUS
&kp Z      &mt LEFT_SHIFT X  &kp C         &kp V        &kp B                                                                    &kp N                    &kp M           &kp COMMA                     &mt RIGHT_SHIFT PERIOD  &mt2 SLASH RS(SLASH)
&kp LCTRL  &kp LEFT_ALT      &kp LEFT_WIN  &lt 1 SPACE  &mt LEFT_GUI TAB  &mt LEFT_SHIFT LANGUAGE_2  &mt RIGHT_SHIFT LANGUAGE_1  &mt RIGHT_GUI BACKSPACE  &lt 2 SPACE     &mt2 RS(SEMICOLON) SEMICOLON  &mt2 SQT RS(SQT)        &kp BACKSLASH
           &mkp MB2          &kp RIGHT     &kp DOWN     &kp LEFT          &kp UP                     &mmv MOVE_UP                &mmv MOVE_LEFT           &mmv MOVE_DOWN  &mmv MOVE_RIGHT               &mkp MB1
&mkp MB1   &mkp MB2          &mkp MB3                                                                                                                                     &mkp MB1                      &mkp MB2                &mkp MB3
&mkp MB4   &mkp MB5          &kp LG(TAB)   &kp LG(H)    &kp LCTRL                                                                &mkp MB4                 &mkp MB5        &kp LG(TAB)                   &kp LG(H)               &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp LS(F1)           &kp LA(F1)           &kp LC(DOWN_ARROW)   &kp LG(F4)           &kp LG(F1)                                                  &kp CLEAR              &kp KP_NUMBER_7    &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&mt2 F1 KP_NUMBER_1  &mt2 F2 KP_NUMBER_2  &mt2 F3 KP_NUMBER_3  &mt2 F4 KP_NUMBER_4  &mt2 F5 KP_NUMBER_5                                         &kp AT                 &kp KP_NUMBER_4    &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&mt2 F6 KP_NUMBER_6  &mt2 F7 KP_NUMBER_7  &mt2 F8 KP_NUMBER_8  &mt2 F9 KP_NUMBER_9  &mt2 F10 KP_NUMBER_0                                        &kp UNDER              &kp KP_NUMBER_1    &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
&kp LCTRL            &kp LALT             &kp LGUI             &trans               &trans                &kp LEFT_SHIFT  &kp RG(LEFT_BRACKET)  &kp RG(RIGHT_BRACKET)  &trans             &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_DIVIDE
                     &trans               &mmv MOVE_RIGHT      &mmv MOVE_DOWN       &mmv MOVE_LEFT        &mmv MOVE_UP    &kp UP_ARROW          &kp LEFT_ARROW         &kp DOWN           &kp RIGHT_ARROW  &trans
&trans               &trans               &trans                                                                                                                                          &trans           &trans           &trans
&kp LC(LG(LEFT))     &kp LC(LG(RIGHT))    &trans               &trans               &trans                                                      &kp LC(LG(LEFT))       &kp LC(LG(RIGHT))  &trans           &trans           &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH              &kp DOLLAR             &kp PERCENT                            &kp PAGE_UP    &kp HOME  &kp UP_ARROW    &kp END    &kp RIGHT_CONTROL
&kp CARET        &kp AMPERSAND  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ASTRK                              &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp RIGHT_ALT
&kp GRAVE        &kp SQT        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none                                  &none          &mkp MB1  &mkp MB3        &mkp MB2   &kp RIGHT_WIN
&kp LCTRL        &kp LALT       &kp LGUI              &trans                 &kp LS(F16)  &kp F16  &kp RIGHT_SHIFT  &trans         &trans    &none           &none      &kp RIGHT_SHIFT
                 &trans         &trans                &trans                 &trans       &trans   &trans           &trans         &trans    &trans          &trans
&trans           &trans         &trans                                                                                                       &trans          &trans     &trans
&trans           &trans         &trans                &trans                 &trans                                 &trans         &trans    &trans          &trans     &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &none
&kp F11  &kp F12  &none   &none   &none                    &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&none    &none    &none   &none   &none    &none   &none   &none                          &none                          &none                          &none                          &none
         &trans   &trans  &trans  &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                 &trans                         &trans                         &trans
&trans   &trans   &trans  &trans  &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };

        Win_Layer {
            display-name = "Default";
            bindings = <
&kp Q      &kp W         &kp E         &kp R        &kp T                                                                 &kp Y                        &kp U           &kp I                        &kp O                           &kp P
&kp A      &kp S         &kp D         &kp F        &kp G                                                                 &kp H                        &kp J           &kp K                        &kp L                           &mt2 EQUAL MINUS
&kp Z      &kp X         &kp C         &kp V        &kp B                                                                 &kp N                        &kp M           &kp COMMA                    &kp DOT                         &mt2 SLASH SLASH
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &lt 5 SPACE  &mt LCTRL TAB  &mt LEFT_SHIFT LANGUAGE_2  &mt RIGHT_SHIFT LANGUAGE_1  &mt RIGHT_CONTROL BACKSPACE  &lt 6 SPACE     &mt2 SINGLE_QUOTE SEMICOLON  &mt2 RS(NUMBER_7) RS(NUMBER_2)  &kp INTERNATIONAL_3
           &mkp MB2      &kp RIGHT     &kp DOWN     &kp LEFT       &kp UP                     &mmv MOVE_UP                &mmv MOVE_LEFT               &mmv MOVE_DOWN  &mmv MOVE_RIGHT              &mkp MB1
&mkp LCLK  &mkp RCLK     &mkp MCLK                                                                                                                                     &mkp LCLK                    &mkp RCLK                       &mkp MCLK
&mkp MB4   &mkp MB5      &kp LG(TAB)   &kp LG(D)    &kp LCTRL                                                             &mkp MB4                     &mkp MB5        &kp LG(TAB)                  &kp RG(D)                       &kp RCTRL
            >;
        };

        Win_Secondary {
            display-name = "secondary_layer";
            bindings = <
&kp RG(TAB)          &kp RG(D)            &kp LC(TAB)          &kp LG(T)            &kp LA(F4)                                          &kp CLEAR                &kp KP_NUMBER_7    &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&mt2 F1 KP_NUMBER_1  &mt2 F2 KP_NUMBER_2  &mt2 F3 KP_NUMBER_3  &mt2 F4 KP_NUMBER_4  &mt2 F5 KP_NUMBER_5                                 &kp LEFT_BRACKET         &kp KP_NUMBER_4    &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&mt2 F6 KP_NUMBER_6  &mt2 F7 KP_NUMBER_7  &mt2 F8 KP_NUMBER_8  &mt2 F9 KP_NUMBER_9  &mt2 F10 KP_NUMBER_0                                &kp RS(INTERNATIONAL_1)  &kp KP_NUMBER_1    &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
&kp LCTRL            &kp LALT             &kp LGUI             &lt 5 LANGUAGE_2     &kp LEFT_CONTROL      &kp LEFT_SHIFT  &kp RA(LEFT)  &kp RA(RIGHT_ARROW)      &lt 6 LANGUAGE_1   &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_DIVIDE
                     &trans               &mmv MOVE_RIGHT      &mmv MOVE_DOWN       &mmv MOVE_LEFT        &mmv MOVE_UP    &kp UP_ARROW  &kp LEFT_ARROW           &kp DOWN           &kp RIGHT_ARROW  &trans
&trans               &trans               &trans                                                                                                                                    &trans           &trans           &trans
&kp LC(LG(LEFT))     &kp LC(LG(RIGHT))    &trans               &trans               &trans                                              &kp LC(LG(LEFT))         &kp LC(LG(RIGHT))  &trans           &trans           &trans
            >;
        };

        Win_Tertiary {
            display-name = "tertiary_layer";
            bindings = <
&kp LS(N1)     &kp LS(LEFT_BRACKET)  &kp LS(NUMBER_3)   &kp LS(NUMBER_4)  &kp LS(N5)                                             &kp PAGE_UP    &kp HOME          &kp UP_ARROW    &kp END    &kp RCTRL
&kp EQUAL      &kp LS(NUMBER_6)      &kp LS(NUMBER_8)   &kp LS(NUMBER_9)  &kp LS(SINGLE_QUOTE)                                   &kp PAGE_DOWN  &kp LEFT          &kp DOWN_ARROW  &kp RIGHT  &kp RIGHT_ALT
&kp LS(EQUAL)  &kp LS(N7)            &kp RIGHT_BRACKET  &kp NUHS          &kp SINGLE_QUOTE                                       &none          &mkp MB1          &mkp MB3        &mkp MB2   &kp RIGHT_WIN
&kp LCTRL      &kp LALT              &kp LGUI           &lt 5 LANGUAGE_2  &kp LG(LEFT)          &kp RG(RIGHT_ARROW)  &kp RSHIFT  &kp RCTRL      &lt 6 LANGUAGE_1  &none           &none      &kp RIGHT_SHIFT
               &trans                &trans             &trans            &trans                &trans               &trans      &trans         &trans            &trans          &trans
&trans         &trans                &trans                                                                                                                       &trans          &trans     &trans
&trans         &trans                &trans             &trans            &trans                                                 &trans         &trans            &trans          &trans     &trans
            >;
        };

        Win_Syslayer {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &none
&kp F11  &kp F12  &none   &none   &none                    &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&none    &none    &none   &none   &none    &none   &none   &none                          &none                          &none                          &none                          &none
         &trans   &trans  &trans  &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                 &trans                         &trans                         &trans
&trans   &trans   &trans  &trans  &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        Cond_Syslayer_2 {
            if-layers = <5 6>;
            then-layer = <7>;
        };
    };
};
